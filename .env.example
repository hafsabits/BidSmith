# Copy to .env and fill in.
ANTHROPIC_API_KEY=
# SAM.gov Get Opportunities API (only needed for `make fetch-sam`).
# SAM_ENV=alpha uses https://api-alpha.sam.gov (prod-like test data): create the key on alpha.sam.gov -> Account Details.
# SAM_ENV=production uses https://api.sam.gov: create the key on sam.gov -> Account Details.
# Keys are environment-specific. Public keys allow only a few requests per day.
SAM_ENV=alpha
SAM_API_KEY=
SAM_MAX_REQUESTS=8
INCLUDE_SAMPLE_OPPORTUNITIES=true

DATABASE_URL=postgresql+psycopg://bidsmith:bidsmith@localhost:5433/bidsmith

# Model routing (override to experiment)
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-opus-5-5
SMART_EFFORT=high

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
