# Copy to .env and fill in.
ANTHROPIC_API_KEY=
# Free key from a SAM.gov account (Account Details -> API Key). Only needed for `make fetch-sam`.
SAM_API_KEY=

DATABASE_URL=postgresql+psycopg://bidsmith:bidsmith@localhost:5433/bidsmith

# Model routing (override to experiment)
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-opus-5-5
SMART_EFFORT=high

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
